{
	admin off
	auto_https off
	persist_config off
	log {
		output stdout
		format console
	}
	servers {
		# The edge service is published only on host loopback. Trust private
		# upstream addresses and the dedicated HK subscription gateway without
		# accepting arbitrary public spoofed hops.
		trusted_proxies static private_ranges 103.133.179.159/32
		trusted_proxies_strict
	}
}

:7001 {
	encode zstd gzip

	@untrusted_gateway_path {
		remote_ip 103.133.179.159/32
		not {
			method GET HEAD OPTIONS
			path /s/* /api/v1/client/subscribe /api/v1/client/distributor/claim/*
		}
	}
	respond @untrusted_gateway_path "Forbidden" 403

	@ws path /ws
	reverse_proxy @ws ws:8076

	reverse_proxy web:7001 {
		header_up Host {host}
		header_up X-Real-IP {client_ip}
	}
}
